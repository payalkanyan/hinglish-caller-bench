# hinglish-caller-bench API keys
# Used by: hcb run (--provider groq | gemini | openrouter)

# Groq — default provider for hcb run
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — alternative provider
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — alternative provider (routes to many models)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
