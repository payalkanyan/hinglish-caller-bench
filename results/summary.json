      "wrong_args": [],
      "forbidden_violations": [],
      "precedence_violations": [],
      "turns": [
        {
          "speaker": "caller",
          "text": "\u0928\u092e\u0938\u094d\u0924\u0947, \u092e\u0948\u0902\u0928\u0947 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u090f\u0915 \u0938\u0930\u094b\u0915\u0930\u0940 \u0938\u0947\u091f \u0915\u093e \u0911\u0930\u094d\u0921\u0930 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0947 \u0938\u092e\u092f \u091c\u093f\u0938 \u092c\u0949\u0915\u094d\u0938 \u0915\u094b \u092e\u0941\u091d\u0947 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0935\u094b \u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u0915\u0941\u091a\u0932\u093e \u0939\u0941\u0906 \u0925\u093e \u0914\u0930 \u0905\u0902\u0926\u0930 \u0938\u0947 \u091f\u0942\u091f\u0947 \u0939\u0941\u090f \u0915\u093e\u0902\u091a \u0915\u0940 \u0906\u0935\u093e\u091c \u0906 \u0930\u0939\u0940 \u0925\u0940\u0964 \u092e\u0948\u0902\u0928\u0947 \u0916\u094b\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092b\u094b\u091f\u094b \u0932\u0947 \u0932\u0940 \u0925\u0940\u0964 \u092e\u0941\u091d\u0947 \u0907\u0938\u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0926\u0930\u094d\u091c \u0915\u0930\u093e\u0928\u0940 \u0939\u0948 \u0914\u0930 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u092f\u093e \u0930\u093f\u092b\u0902\u0921 \u091a\u093e\u0939\u093f\u090f\u0964"
        },
        {
          "speaker": "agent",
          "text": "\u0928\u092e\u0938\u094d\u0924\u0947 \u091c\u0940\u0964 \u0906\u092a\u0915\u0947 \u0907\u0938 \u0905\u0928\u0941\u092d\u0935 \u0915\u0947 \u0932\u093f\u090f \u092e\u0941\u091d\u0947 \u0916\u0947\u0926 \u0939\u0948\u0964 \n\n\u0907\u0938 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u093e \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0941\u091d\u0947 \u0906\u092a\u0915\u0947 \u0911\u0930\u094d\u0921\u0930 \u0928\u0902\u092c\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0917\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0911\u0930\u094d\u0921\u0930 \u0928\u0902\u092c\u0930 \u092c\u0924\u093e \u0926\u0940\u091c\u093f\u090f, \u0924\u093e\u0915\u093f \u092e\u0948\u0902 \u0906\u0917\u0947 \u0915\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930 \u0938\u0915\u0942\u0902\u0964"
        },
        {
          "speaker": "caller",
          "text": "\u091c\u0940 \u0939\u093e\u0901, \u092e\u0947\u0930\u093e \u0911\u0930\u094d\u0921\u0930 \u0906\u0908\u0921\u0940 ORD-22006 \u0939\u0948\u0964"
        },
        {
          "speaker": "agent",
          "text": "\u0906\u092a\u0915\u0947 \u0911\u0930\u094d\u0921\u0930 (ORD-22006) \u0915\u0947 \u0932\u093f\u090f \u20b92,199 \u0915\u093e \u0930\u093f\u092b\u0902\u0921 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \n\n\u091a\u0942\u0902\u0915\u093f \u092c\u0949\u0915\u094d\u0938 \u0915\u094d\u0937\u0924\u093f\u0917\u094d\u0930\u0938\u094d\u0924 \u0925\u093e, \u0906\u092a\u0928\u0947 \u092b\u094b\u091f\u094b \u0932\u0947 \u0932\u0940 \u0939\u0948 \u092f\u0939 \u092c\u0939\u0941\u0924 \u0905\u091a\u094d\u091b\u093e \u0915\u093f\u092f\u093e\u0964 \u0930\u093f\u092b\u0902\u0921 \u0915\u0940 \u0930\u093e\u0936\u093f \u0915\u0941\u091b \u0939\u0940 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0913\u0930\u093f\u091c\u093f\u0928\u0932 \u092a\u0947\u092e\u0947\u0902\u091f \u092e\u0947\u0925\u0921 \u092a\u0930 \u092a\u0939\u0941\u0901\u091a \u091c\u093e\u090f\u0917\u0940\u0964 \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0915\u093f\u0938\u0940 \u0914\u0930 \u0938\u0939\u093e\u092f\u0924\u093e \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?"
        },
        {
          "speaker": "caller",
          "text": "\u091c\u0940, \u0906\u092a\u0928\u0947 \u0938\u0939\u0940 \u0915\u093f\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0924\u094b \u0936\u0941\u0930\u0942 \u092e\u0947\u0902 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0915\u093e \u092d\u0940 \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u0942\u091b\u093e \u0925\u093e, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0941\u091d\u0947 \u0935\u094b \u0938\u0930\u094b\u0915\u0930\u0940 \u0938\u0947\u091f \u091a\u093e\u0939\u093f\u090f \u0925\u093e\u0964 \u0905\u0917\u0930 \u0930\u093f\u092b\u0902\u0921 \u0939\u0940 \u0939\u094b \u0930\u0939\u093e \u0939\u0948, \u0924\u094b \u0920\u0940\u0915 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u092a\u0948\u0938\u093e \u0935\u093e\u092a\u0938 \u0915\u093f\u0924\u0928\u0947 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u092e\u093f\u0932\u0947\u0917\u093e? \u0914\u0930 \u0915\u094d\u092f\u093e \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0941\u091d\u0947 \u0915\u094b\u0908 \u0915\u0949\u0928\u094d\u092b\u0930\u094d\u092e\u0947\u0936\u0928 \u092e\u093f\u0932\u0947\u0917\u093e?"
        },
        {
          "speaker": "agent",
          "text": "\u0930\u093f\u092b\u0902\u0921 \u0915\u0940 \u0930\u093e\u0936\u093f \u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0924\u0903 3 \u0938\u0947 5 \u0915\u093e\u0930\u094d\u092f \u0926\u093f\u0935\u0938\u094b\u0902 (business days) \u0915\u0947 \u092d\u0940\u0924\u0930 \u0906\u092a\u0915\u0947 \u0913\u0930\u093f\u091c\u093f\u0928\u0932 \u092a\u0947\u092e\u0947\u0902\u091f \u092e\u0947\u0925\u0921 \u092e\u0947\u0902 \u0935\u093e\u092a\u0938 \u0906 \u091c\u093e\u090f\u0917\u0940\u0964 \n\n\u091c\u0948\u0938\u0947 \u0939\u0940 \u0930\u093f\u092b\u0902\u0921 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u092a\u0942\u0930\u093e \u0939\u094b\u0917\u093e, \u0906\u092a\u0915\u094b \u0906\u092a\u0915\u0947 \u0930\u091c\u093f\u0938\u094d\u091f\u0930\u094d\u0921 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0908\u092e\u0947\u0932 \u092a\u0930 \u090f\u0915 \u0915\u0928\u094d\u092b\u0930\u094d\u092e\u0947\u0936\u0928 \u092e\u0948\u0938\u0947\u091c (\u092a\u0941\u0937\u094d\u091f\u093f \u0938\u0902\u0926\u0947\u0936) \u092e\u093f\u0932 \u091c\u093e\u090f\u0917\u093e\u0964 \n\n\u0905\u0917\u0930 \u0906\u092a \u091a\u093e\u0939\u0947\u0902 \u0924\u094b \u0909\u0938\u0940 \u0938\u0930\u094b\u0915\u0930\u0940 \u0938\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0928\u092f\u093e \u0911\u0930\u094d\u0921\u0930 \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u0906\u0907\u091f\u092e \u0905\u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0907\u0938\u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0915\u094b\u0908 \u0914\u0930 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?"
        }
      ]
